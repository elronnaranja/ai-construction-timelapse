{
  "audio_mode": "construction_sfx_no_music",
  "keep": [
    "relevant tools and machinery",
    "footsteps and material handling",
    "visually appropriate water sounds"
  ],
  "exclude": [
    "background music",
    "musical score or beats",
    "singing",
    "narration",
    "voiceover",
    "dialogue",
    "unrelated sounds"
  ],
  "silent_by_default": false,
  "ending": "fully finished property with a two-second completed-image hold",
  "cash_budget_default": 0,
  "audio_source": "separate_reviewed_sfx_only",
  "flow_audio_allowed": false,
  "audio_review_required": true,
  "on_unreviewed_audio": "block_delivery",
  "on_missing_sfx": "block_assembly",
  "aspect_default": "9:16",
  "flow_credits_per_transition_expected": 10,
  "flow_transition_count": 5,
  "flow_existing_credit_cap_default": 50,
  "standard_run_preauthorized": true,
  "hero_user_approval_required": false,
  "prompt_entry": "single_fill_or_paste",
  "pricing_check": "visible_project_settings_once",
  "ask_only_for_blockers": true
}
